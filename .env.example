# URL base del provider LiteLLM (compatibile OpenAI)
LITELLM_BASE_URL=https://your-litellm-gateway.example/v1

# Nome del modello servito dal gateway
LITELLM_MODEL=your-model-name

# Chiave di accesso al gateway LiteLLM
LITELLM_API_KEY=your-litellm-api-key

# Chiave Tavily, usata da /api/generate-from-link per estrarre il contenuto
TAVILY_API_KEY=your-tavily-api-key

# Origini CORS accettate dal backend (in formato JSON)
CORS_ORIGINS=["http://localhost:5173"]
