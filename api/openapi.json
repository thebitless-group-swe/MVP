{
  "components": {
    "schemas": {
      "ApiConstants": {
        "description": "Costanti del contratto lette dal frontend tramite openapi-typescript.\n\nIl campo e' tipizzato come letterale, quindi in /openapi.json compare come\n`const`.",
        "properties": {
          "no_errors_marker": {
            "const": "NESSUN_ERRORE_RILEVATO",
            "default": "NESSUN_ERRORE_RILEVATO",
            "title": "No Errors Marker",
            "type": "string"
          }
        },
        "title": "ApiConstants",
        "type": "object"
      },
      "CritiqueRequest": {
        "properties": {
          "hat": {
            "enum": [
              "bianco",
              "rosso",
              "giallo",
              "nero",
              "verde",
              "blu"
            ],
            "title": "Hat",
            "type": "string"
          },
          "text": {
            "minLength": 10,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text",
          "hat"
        ],
        "title": "CritiqueRequest",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "GenerateRequest": {
        "properties": {
          "length": {
            "default": "medio",
            "enum": [
              "breve",
              "medio",
              "dettagliato"
            ],
            "title": "Length",
            "type": "string"
          },
          "prompt": {
            "minLength": 3,
            "title": "Prompt",
            "type": "string"
          }
        },
        "required": [
          "prompt"
        ],
        "title": "GenerateRequest",
        "type": "object"
      },
      "GrammarRequest": {
        "properties": {
          "text": {
            "minLength": 10,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "GrammarRequest",
        "type": "object"
      },
      "LinkRequest": {
        "properties": {
          "length": {
            "default": "medio",
            "enum": [
              "breve",
              "medio",
              "dettagliato"
            ],
            "title": "Length",
            "type": "string"
          },
          "url": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "title": "LinkRequest",
        "type": "object"
      },
      "RewriteRequest": {
        "properties": {
          "style": {
            "enum": [
              "formale",
              "informale",
              "accademico"
            ],
            "title": "Style",
            "type": "string"
          },
          "text": {
            "minLength": 10,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text",
          "style"
        ],
        "title": "RewriteRequest",
        "type": "object"
      },
      "TextRequest": {
        "properties": {
          "length": {
            "default": "medio",
            "enum": [
              "breve",
              "medio",
              "dettagliato"
            ],
            "title": "Length",
            "type": "string"
          },
          "text": {
            "minLength": 10,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "TextRequest",
        "type": "object"
      },
      "TranslateRequest": {
        "properties": {
          "target_language": {
            "enum": [
              "inglese",
              "francese",
              "tedesco",
              "spagnolo"
            ],
            "title": "Target Language",
            "type": "string"
          },
          "text": {
            "minLength": 10,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text",
          "target_language"
        ],
        "title": "TranslateRequest",
        "type": "object"
      }
    }
  },
