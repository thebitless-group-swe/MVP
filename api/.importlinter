[importlinter]
root_package = app
include_external_packages = True

[importlinter:contract:core-indipendente]
name = Il core non conosce l'infrastruttura né i framework
type = forbidden
source_modules = app.core
forbidden_modules =
    fastapi
    httpx
    tavily
    pydantic_settings
    app.infrastructure
    app.api

[importlinter:contract:layers]
name = Direzione delle dipendenze
type = layers
layers =
    app.api
    app.infrastructure
    app.core

# I moduli elencati sono i due adattatori secondari, cioe' quelli che
# realizzano una porta di app.core.ports. sse_streaming non e' piu' fra questi:
# e' stato spostato in app.api perche' non realizza alcuna porta e non parla con
# alcun servizio esterno. Restarci lo avrebbe fatto figurare come un terzo
# adattatore secondario, che non e'.
[importlinter:contract:adapter-indipendente]
name = Gli adattatori non si importano tra loro
type = independence
modules =
    app.infrastructure.adapters.tavily_extractor
    app.infrastructure.adapters.litellm_client

[importlinter:contract:core-non-importa-settings]
name = Il core non importa direttamente app.settings
type = forbidden
source_modules = app.core
forbidden_modules = app.settings